{
  "info": {
    "name": "Pharmacy Shelf Recall Routing",
    "description": "API workflow for authentication, product lot seeding, shelf stock seeding, medicine recall, and workflow verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login recall officer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"recall.officer\",\n  \"password\": \"demo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base}}/auth/login",
          "host": [
            "{{base}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Seed lots",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base}}/lots/seed",
          "host": [
            "{{base}}"
          ],
          "path": [
            "lots",
            "seed"
          ]
        }
      }
    },
    {
      "name": "3. Seed shelf stock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base}}/stock/seed",
          "host": [
            "{{base}}"
          ],
          "path": [
            "stock",
            "seed"
          ]
        }
      }
    },
    {
      "name": "4. Recall LOT-A100",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lotCode\": \"LOT-A100\",\n  \"productCode\": \"MED-100\",\n  \"reason\": \"simulated supplier quality alert\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base}}/recall",
          "host": [
            "{{base}}"
          ],
          "path": [
            "recall"
          ]
        }
      }
    },
    {
      "name": "5. View workflow state",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base}}/workflow",
          "host": [
            "{{base}}"
          ],
          "path": [
            "workflow"
          ]
        }
      }
    }
  ]
}